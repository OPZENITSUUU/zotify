# Copy to keystore.properties and fill in. That file is gitignored — the real
# passwords must never be committed.
#
# Local development key only. This will NOT pass the official release workflow's pinned-certificate check.
# Official releases must use the private signing handoff and repository Actions secrets.
# Create a local test key once, from the project root:
#
#   keytool -genkey -v -keystore zotify-local.jks \
#       -keyalg RSA -keysize 2048 -validity 10000 -alias zotify-local
#
# Back up this local .jks and its passwords. Losing it means locally signed
# test builds cannot update in place. This local key is separate from the
# official release key and must never be used for a published release.

storeFile=zotify-local.jks
storePassword=
keyAlias=zotify-local
keyPassword=
